<odoo>
    <record id="restaurant_daily_sales_accounting_view_list" model="ir.ui.view">
        <field name="name">restaurant.accounting.daily.sales.list</field>
        <field name="model">restaurant.accounting.daily.sales</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'"
                  decoration-info="state in ('reviewed','draft_entry')"
                  decoration-success="state == 'posted'">
                <field name="name"/>
                <field name="business_date"/>
                <field name="branch_id"/>
                <field name="total_sales" sum="Sales"/>
                <field name="vat_amount" sum="VAT"/>
                <field name="payment_difference" sum="Difference" optional="show"/>
                <field name="total_tips" sum="Tips" optional="show"/>
                <field name="journal_entry_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_daily_sales_accounting_view_form" model="ir.ui.view">
        <field name="name">restaurant.accounting.daily.sales.form</field>
        <field name="model">restaurant.accounting.daily.sales</field>
        <field name="arch" type="xml">
            <form string="Daily Sales Accounting" create="0" delete="0">
                <header>
                    <button name="action_review" type="object" string="Accounting Review Complete"
                            class="btn-primary" invisible="state != 'pending'"
                            groups="restaurant_core.group_restaurant_accountant"/>
                    <button name="action_create_journal_entry" type="object"
                            string="Create Draft Journal Entry" class="btn-primary"
                            invisible="state != 'reviewed'"
                            groups="restaurant_core.group_restaurant_accountant"/>
                    <button name="action_post_journal_entry" type="object"
                            string="Post Journal Entry" class="btn-primary"
                            invisible="state != 'draft_entry'"
                            groups="restaurant_core.group_restaurant_accountant"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,reviewed,draft_entry,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Source">
                            <field name="closing_id" readonly="1"/>
                            <field name="business_date" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="journal_entry_id" readonly="1" invisible="not journal_entry_id"/>
                        </group>
                        <group string="Sales &amp; VAT">
                            <field name="total_sales" readonly="1"/>
                            <field name="net_sales" readonly="1"/>
                            <field name="vat_amount" readonly="1"/>
                            <field name="pos_reported_vat" readonly="1"/>
                            <field name="vat_difference" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment Match">
                            <field name="cash_sales" readonly="1"/>
                            <field name="card_sales" readonly="1"/>
                            <field name="delivery_sales" readonly="1"/>
                            <field name="other_sales" readonly="1"/>
                            <field name="payment_total" readonly="1"/>
                            <field name="payment_difference" readonly="1"/>
                        </group>
                        <group string="Tips Liability">
                            <field name="cash_tips" readonly="1"/>
                            <field name="card_tips" readonly="1"/>
                            <field name="delivery_tips" readonly="1"/>
                            <field name="other_tips" readonly="1"/>
                            <field name="total_tips" readonly="1"/>
                        </group>
                    </group>
                    <group string="Accounting Review">
                        <field name="review_note" readonly="state not in ('pending','reviewed','draft_entry','posted')"/>
                    </group>
                    <group string="Audit Trail">
                        <field name="reviewed_by_id" readonly="1"/>
                        <field name="reviewed_at" readonly="1"/>
                        <field name="posted_by_id" readonly="1"/>
                        <field name="posted_at" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_daily_sales_accounting_view_search" model="ir.ui.view">
        <field name="name">restaurant.accounting.daily.sales.search</field>
        <field name="model">restaurant.accounting.daily.sales</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="business_date"/>
                <filter name="pending" string="Pending Review" domain="[('state', '=', 'pending')]"/>
                <filter name="not_posted" string="Not Posted" domain="[('state', '!=', 'posted')]"/>
                <separator/>
                <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'business_date:month'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="restaurant_daily_sales_accounting_action" model="ir.actions.act_window">
        <field name="name">Daily Sales Accounting</field>
        <field name="res_model">restaurant.accounting.daily.sales</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
        <field name="search_view_id" ref="restaurant_daily_sales_accounting_view_search"/>
    </record>
</odoo>
