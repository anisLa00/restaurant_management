<odoo>
    <record id="restaurant_payroll_owner_review_view_list" model="ir.ui.view">
        <field name="name">restaurant.payroll.input.batch.owner.review.list</field>
        <field name="model">restaurant.payroll.input.batch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="state == 'processed'">
                <field name="reference"/>
                <field name="branch_id"/>
                <field name="month_start"/>
                <field name="month_end"/>
                <field name="employee_count"/>
                <field name="total_input_amount" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_payroll_owner_review_view_form" model="ir.ui.view">
        <field name="name">restaurant.payroll.input.batch.owner.review.form</field>
        <field name="model">restaurant.payroll.input.batch</field>
        <field name="arch" type="xml">
            <form string="Payroll Input Review" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="processed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="reference" readonly="1"/></h1></div>
                    <div class="alert alert-info" role="alert">
                        Read-only payroll input review. This does not expose payslips or payment actions.
                    </div>
                    <group>
                        <group string="Period">
                            <field name="attendance_month_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="month_start" readonly="1"/>
                            <field name="month_end" readonly="1"/>
                        </group>
                        <group string="Totals">
                            <field name="employee_count" readonly="1"/>
                            <field name="total_input_amount" readonly="1"/>
                            <field name="prepared_by" readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="prepared_at" readonly="1"/>
                            <field name="processed_by" readonly="1"
                                   options="{'no_open': True}"/>
                            <field name="processed_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="employee_number"/>
                            <field name="employee_id" options="{'no_open': True}"/>
                            <field name="job_id" optional="show" options="{'no_open': True}"/>
                            <field name="calculation_version" optional="hide"/>
                            <field name="base_salary"/>
                            <field name="daily_rate" string="Daily Rate (Salary / 30)"/>
                            <field name="present_days" optional="show"/>
                            <field name="late_count" optional="hide"/>
                            <field name="late_minutes" optional="hide"/>
                            <field name="absence_days" optional="show"/>
                            <field name="gross_unexcused_absence_days" optional="show"/>
                            <field name="absence_overtime_offset_days" optional="show"/>
                            <field name="unpaid_absence_days" string="Counted Unpaid Days"/>
                            <field name="automatic_absence_deduction"/>
                            <field name="paid_leave_days" optional="show"/>
                            <field name="unpaid_leave_days" optional="show"/>
                            <field name="annual_leave_days" optional="hide"/>
                            <field name="sick_leave_days" optional="hide"/>
                            <field name="emergency_leave_days" optional="hide"/>
                            <field name="day_off_days" optional="hide"/>
                            <field name="overtime_days" optional="show"/>
                            <field name="eligible_overtime_days" optional="show"/>
                            <field name="payable_overtime_days" optional="show"/>
                            <field name="automatic_overtime_amount" optional="show"/>
                            <field name="overtime_amount" string="Historical Overtime Amount" optional="hide"/>
                            <field name="correction_allowance_amount" optional="show"/>
                            <field name="correction_deduction_amount" optional="show"/>
                            <field name="allowance_amount"/>
                            <field name="deduction_amount"/>
                            <field name="input_total" sum="Total"/>
                            <field name="adjustment_note" optional="show"/>
                        </list>
                    </field>
                    <group>
                        <field name="hr_note" readonly="1"/>
                        <field name="payroll_note" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_payroll_owner_review_view_search" model="ir.ui.view">
        <field name="name">restaurant.payroll.input.batch.owner.review.search</field>
        <field name="model">restaurant.payroll.input.batch</field>
        <field name="arch" type="xml">
            <search string="Payroll Review">
                <field name="reference"/>
                <field name="branch_id"/>
                <field name="month_start"/>
                <filter name="processed" string="Processed"
                        domain="[('state', '=', 'processed')]"/>
                <group>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'month_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_payroll_owner_review_action" model="ir.actions.act_window">
        <field name="name">Payroll Review</field>
        <field name="res_model">restaurant.payroll.input.batch</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'processed')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="search_view_id" ref="restaurant_payroll_owner_review_view_search"/>
    </record>

    <record id="restaurant_payroll_owner_review_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="restaurant_payroll_owner_review_view_list"/>
        <field name="act_window_id" ref="restaurant_payroll_owner_review_action"/>
    </record>

    <record id="restaurant_payroll_owner_review_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="restaurant_payroll_owner_review_view_form"/>
        <field name="act_window_id" ref="restaurant_payroll_owner_review_action"/>
    </record>
</odoo>
