<odoo>
    <record id="restaurant_tips_collection_view_list" model="ir.ui.view">
        <field name="name">restaurant.tips.collection.list</field>
        <field name="model">restaurant.tips.collection</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'submitted'">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="cycle_start"/>
                <field name="cycle_end" string="Next 15th"/>
                <field name="closing_count"/>
                <field name="waiter_count"/>
                <field name="total_tips" sum="Total Tips"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_tips_collection_view_form" model="ir.ui.view">
        <field name="name">restaurant.tips.collection.form</field>
        <field name="model">restaurant.tips.collection</field>
        <field name="arch" type="xml">
            <form string="Branch Tips Collection">
                <header>
                    <button name="action_refresh" type="object" string="Refresh from Closed Sales"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit to Accountant"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-info" role="alert">
                        This sheet is filled automatically from closed Waiter Sales &amp; Tips.
                        The next 15th belongs to the new cycle and is not included here.
                    </div>
                    <group>
                        <group string="15-to-15 Cycle">
                            <field name="branch_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="cycle_start" readonly="1"/>
                            <field name="cycle_end" string="Next Cycle Starts" readonly="1"/>
                            <field name="last_refreshed_at" readonly="1"/>
                            <field name="last_refreshed_by_id" readonly="1"/>
                        </group>
                        <group string="Collected Tips">
                            <field name="closing_count" readonly="1"/>
                            <field name="waiter_count" readonly="1"/>
                            <field name="total_cash_tips" readonly="1"/>
                            <field name="total_card_tips" readonly="1"/>
                            <field name="total_tips" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Waiters">
                            <field name="waiter_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="employee_id"/>
                                    <field name="cash_tips" sum="Cash Tips"/>
                                    <field name="card_tips" sum="Card Tips"/>
                                    <field name="total_tips" sum="Waiter Tips"/>
                                    <field name="bill_count" sum="Bills"/>
                                    <field name="source_closing_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Closed Sources">
                            <field name="source_closing_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name"/>
                                    <field name="business_date"/>
                                    <field name="cash_tips"/>
                                    <field name="card_tips"/>
                                    <field name="total_tips"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reception Note">
                            <field name="reception_note" readonly="state != 'draft'"/>
                        </page>
                        <page string="Submission Audit">
                            <group>
                                <field name="submitted_by_id" readonly="1"/>
                                <field name="submitted_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_tips_collection_view_search" model="ir.ui.view">
        <field name="name">restaurant.tips.collection.search</field>
        <field name="model">restaurant.tips.collection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="cycle_start"/>
                <filter name="draft" string="In Progress" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_start'}"/>
            </search>
        </field>
    </record>

    <record id="restaurant_tips_collection_action" model="ir.actions.act_window">
        <field name="name">Tips Collection (15th)</field>
        <field name="res_model">restaurant.tips.collection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="restaurant_tips_collection_view_search"/>
        <field name="context">{'search_default_draft': 1}</field>
    </record>

    <record id="restaurant_tips_distribution_view_list" model="ir.ui.view">
        <field name="name">restaurant.tips.distribution.list</field>
        <field name="model">restaurant.tips.distribution</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'prepared'">
                <field name="name"/>
                <field name="cycle_start"/>
                <field name="cycle_end" string="Next 15th"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="global_pool" sum="Global Pool"/>
                <field name="active_staff_count"/>
                <field name="top_waiter_count"/>
                <field name="ordinary_share"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_tips_distribution_view_form" model="ir.ui.view">
        <field name="name">restaurant.tips.distribution.form</field>
        <field name="model">restaurant.tips.distribution</field>
        <field name="arch" type="xml">
            <form string="Tips Distribution">
                <header>
                    <button name="action_refresh" type="object" string="Load Submitted Branch Sheets"
                            invisible="state != 'draft'"/>
                    <button name="action_prepare" type="object" string="Prepare Distribution"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert">
                        Preparation only: this record does not create a payment, payslip,
                        journal entry, or proof that tips were paid.
                    </div>
                    <group>
                        <group string="Global 15-to-15 Pool">
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="cycle_start" readonly="1"/>
                            <field name="cycle_end" string="Next Cycle Starts" readonly="1"/>
                            <field name="global_pool" readonly="1"/>
                            <field name="last_refreshed_at" readonly="1"/>
                            <field name="last_refreshed_by_id" readonly="1"/>
                        </group>
                        <group string="Prepared Formula">
                            <field name="active_staff_count" readonly="1"/>
                            <field name="top_waiter_count" readonly="1"/>
                            <field name="total_units" readonly="1"/>
                            <field name="ordinary_share" readonly="1"/>
                            <field name="allocation_total" readonly="1"/>
                            <field name="rounding_adjustment" readonly="1"/>
                        </group>
                    </group>
                    <group string="Optional Audited Extra Double Share">
                        <field name="extra_double_employee_ids" widget="many2many_tags"
                               readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="extra_double_reason" readonly="state != 'draft'"
                               required="extra_double_employee_ids"/>
                    </group>
                    <notebook>
                        <page string="Branches &amp; Top Count">
                            <field name="branch_line_ids">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="branch_id" readonly="1"/>
                                    <field name="collected_tips" readonly="1" sum="Global Pool"/>
                                    <field name="waiter_count" readonly="1"/>
                                    <field name="top_waiter_count" readonly="parent.state != 'draft'"/>
                                    <field name="collection_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Waiter Ranking">
                            <field name="ranking_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0"
                                      decoration-success="is_top">
                                    <field name="branch_id"/>
                                    <field name="rank"/>
                                    <field name="employee_id"/>
                                    <field name="collected_tips" sum="Waiter Tips"/>
                                    <field name="attendance_days"/>
                                    <field name="is_top"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prepared Staff Shares">
                            <field name="allocation_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0"
                                      decoration-success="share_weight == 2">
                                    <field name="branch_id" optional="show"/>
                                    <field name="employee_id"/>
                                    <field name="waiter_rank" optional="hide"/>
                                    <field name="is_top_waiter"/>
                                    <field name="is_manual_double"/>
                                    <field name="share_weight"/>
                                    <field name="amount" sum="Prepared Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submitted Branch Sheets">
                            <field name="collection_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="branch_id"/>
                                    <field name="name"/>
                                    <field name="total_tips"/>
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_at"/>
                                </list>
                            </field>
                        </page>
                        <page string="Preparation Audit">
                            <group>
                                <field name="prepared_by_id" readonly="1"/>
                                <field name="prepared_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_tips_distribution_view_search" model="ir.ui.view">
        <field name="name">restaurant.tips.distribution.search</field>
        <field name="model">restaurant.tips.distribution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="cycle_start"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="prepared" string="Prepared" domain="[('state', '=', 'prepared')]"/>
                <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_start'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="restaurant_tips_distribution_action" model="ir.actions.act_window">
        <field name="name">Tips Distribution</field>
        <field name="res_model">restaurant.tips.distribution</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="restaurant_tips_distribution_view_search"/>
    </record>
</odoo>
