<odoo>
    <record id="restaurant_menu_item_selection_view_list" model="ir.ui.view">
        <field name="name">restaurant.menu.item.selection.list</field>
        <field name="model">restaurant.menu.item</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list string="Menu Items" default_order="category_id, stock_product_id, name, id"
                  create="0" edit="0" delete="0">
                <field name="display_name" string="Menu Item"/>
                <field name="stock_product_id" string="Product" optional="hide"/>
                <field name="name" string="Flavor" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="branch_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="restaurant_menu_item_selection_view_search" model="ir.ui.view">
        <field name="name">restaurant.menu.item.selection.search</field>
        <field name="model">restaurant.menu.item</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <search string="Menu Items">
                <field name="display_name" string="Menu Item"/>
                <field name="stock_product_id" string="Product"/>
                <field name="name" string="Flavor"/>
                <field name="category_id"/>
                <field name="branch_id"/>
            </search>
        </field>
    </record>

    <record id="restaurant_menu_flavor_view_list" model="ir.ui.view">
        <field name="name">restaurant.menu.flavor.list</field>
        <field name="model">restaurant.menu.flavor</field>
        <field name="arch" type="xml">
            <list string="Manage Flavors" default_order="branch_id, name">
                <field name="name"/>
                <field name="branch_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="restaurant_menu_flavor_view_form" model="ir.ui.view">
        <field name="name">restaurant.menu.flavor.form</field>
        <field name="model">restaurant.menu.flavor</field>
        <field name="arch" type="xml">
            <form string="Flavor">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="company_id" readonly="1"
                               groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Archive a flavor to remove it from future selection and
                        restore it later when needed. Renaming changes the reusable
                        catalog label only; existing product-specific Menu Item
                        names and historical sales are never rewritten silently.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_menu_flavor_view_search" model="ir.ui.view">
        <field name="name">restaurant.menu.flavor.search</field>
        <field name="model">restaurant.menu.flavor</field>
        <field name="arch" type="xml">
            <search string="Manage Flavors">
                <field name="name"/>
                <field name="branch_id"/>
                <filter name="archived" string="Archived Flavors"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_menu_flavor_action" model="ir.actions.act_window">
        <field name="name">Manage Flavors</field>
        <field name="res_model">restaurant.menu.flavor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="restaurant_menu_flavor_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reusable flavor</p>
            <p>Archived flavors remain recoverable and keep all historical links.</p>
        </field>
    </record>

    <record id="restaurant_menu_mapping_profile_view_list" model="ir.ui.view">
        <field name="name">restaurant.menu.setup.list</field>
        <field name="model">restaurant.menu.mapping.profile</field>
        <field name="arch" type="xml">
            <list string="Menu Setup" default_order="branch_id, stock_product_id"
                  decoration-warning="not configuration_complete">
                <field name="stock_product_id" string="Native Stock Product"/>
                <field name="branch_id"/>
                <field name="category_id"/>
                <field name="size_applicable" string="Half / Full"/>
                <field name="allow_additional_consumption" optional="show"/>
                <field name="standard_stock_qty" optional="show"/>
                <field name="half_stock_qty" optional="show"/>
                <field name="full_stock_qty" optional="show"/>
                <field name="configuration_complete" string="Ready" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="restaurant_menu_mapping_profile_view_form" model="ir.ui.view">
        <field name="name">restaurant.menu.setup.form</field>
        <field name="model">restaurant.menu.mapping.profile</field>
        <field name="arch" type="xml">
            <form string="Menu Setup">
                <header>
                    <button name="action_manage_flavors"
                            type="object"
                            string="Manage Flavors"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="name" invisible="1"/>
                    <div class="oe_title">
                        <label for="stock_product_id" string="Native Stock Product"/>
                        <h1>
                            <field name="stock_product_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="category_id" required="1"
                                   domain="[('branch_id', '=', branch_id)]"
                                   context="{'default_branch_id': branch_id}"
                                   options="{'no_open': True}"/>
                            <field name="size_applicable"
                                   string="Sold as Half / Full Portions"/>
                            <field name="allow_additional_consumption"/>
                        </group>
                        <group>
                            <field name="stock_uom_id" string="Stock Unit"
                                   required="1" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="standard_stock_qty"
                                   string="Stock Units per Standard"
                                   required="not size_applicable"
                                   readonly="1"
                                   invisible="size_applicable"/>
                            <field name="half_stock_qty"
                                   string="Stock Units per Half Portion"
                                   required="size_applicable"
                                   readonly="1"
                                   invisible="not size_applicable"/>
                            <field name="full_stock_qty"
                                   string="Stock Units per Full Portion"
                                   required="size_applicable"
                                   readonly="1"
                                   invisible="not size_applicable"/>
                            <field name="configuration_complete" string="Ready"
                                   readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Select the existing native Stock Product once. Standard uses
                        one stock unit. When Half / Full Portions is enabled, Half
                        uses 0.5 and Full uses 1.0 of that same stock unit. Select
                        all applicable flavors from the reusable branch catalog.
                        If no flavor is selected, Plain is selected automatically.
                        Reception enters the Standard count, or the Half and Full
                        counts together. On Hand stock is managed in Stock, not here.
                        Enable Additional Consumption only when this same stock
                        product also has manual preparation usage that is not already
                        deducted by Sold mapping. It applies only to this branch and
                        starts at zero on every new Daily Stock sheet.
                    </div>
                    <separator string="Flavors shown to Reception"/>
                    <group>
                        <field name="flavor_ids" id="flavor_quick_add"
                               string="Add or search a reusable flavor"
                               widget="many2many_tags"
                               domain="[('branch_id', '=', branch_id),
                                        ('active', '=', True)]"
                               context="{'default_branch_id': branch_id}"
                               options="{'no_open': True}"/>
                    </group>
                    <field name="flavor_ids" id="flavor_checklist"
                           string="Select all applicable flavors"
                           widget="many2many_checkboxes"
                           domain="[('branch_id', '=', branch_id),
                                    ('active', '=', True)]"
                           context="{'default_branch_id': branch_id}"/>
                    <field name="item_ids" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_menu_mapping_profile_view_search" model="ir.ui.view">
        <field name="name">restaurant.menu.setup.search</field>
        <field name="model">restaurant.menu.mapping.profile</field>
        <field name="arch" type="xml">
            <search string="Menu Setup">
                <field name="stock_product_id"/>
                <field name="category_id"/>
                <field name="branch_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="restaurant_menu_mapping_profile_action"
            model="ir.actions.act_window">
        <field name="name">Menu Setup</field>
        <field name="res_model">restaurant.menu.mapping.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="restaurant_menu_mapping_profile_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up one menu item</p>
            <p>
                Select an existing native Stock Product once, choose Standard or
                Half / Full quantities, and add every flavor in this same form.
            </p>
        </field>
    </record>
</odoo>
