<odoo>
    <record id="restaurant_shift_roster_pdf_view" model="ir.ui.view">
        <field name="name">restaurant.shift.roster.official.pdf</field>
        <field name="model">restaurant.shift.roster</field>
        <field name="inherit_id" ref="restaurant_reception.restaurant_shift_roster_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_download_official_pdf" type="object"
                        string="Download PDF" class="btn-secondary"
                        invisible="state != 'published'"/>
            </xpath>
        </field>
    </record>

