<odoo>

    <menuitem
        id="restaurant_stock_menu_root"
        name="Stock"
        parent="restaurant_core.restaurant_menu_root"
        sequence="30"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager,restaurant_core.group_restaurant_central_storekeeper,restaurant_core.group_restaurant_purchasing,restaurant_core.group_restaurant_operations_manager,restaurant_core.group_restaurant_owner,base.group_system"
    />

    <menuitem
        id="restaurant_stock_daily_menu"
        name="Daily Stock"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_daily_action"
        sequence="10"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager,restaurant_core.group_restaurant_central_storekeeper,restaurant_core.group_restaurant_operations_manager,restaurant_core.group_restaurant_owner,base.group_system"
    />

    <menuitem
        id="restaurant_stock_section_menu"
        name="Kitchen / Bar Setup"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_section_action"
        sequence="11"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager,restaurant_core.group_restaurant_central_storekeeper,restaurant_core.group_restaurant_operations_manager,restaurant_core.group_restaurant_owner,base.group_system"
    />

    <!-- Product Category now determines Kitchen, Bar, or Disposable
         automatically. Keep the stable XML ID inactive so upgrades remove the
         obsolete manual setup entry without deleting historical sections. -->
    <record id="restaurant_stock_section_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem
        id="restaurant_branch_daily_stock_menu"
        name="Branch Daily Stock"
        parent="restaurant_stock_menu_root"
        action="restaurant_central_daily_report_server_action"
        sequence="17"
        groups="restaurant_core.group_restaurant_central_storekeeper"/>

    <menuitem
        id="restaurant_daily_product_total_menu"
        name="Daily Product Totals"
        parent="restaurant_stock_menu_root"
        action="restaurant_daily_product_total_action"
        sequence="18"
        groups="restaurant_core.group_restaurant_central_storekeeper"/>

    <!-- Keep the read-only report model/action for the Central dashboard and
         Branch Daily Stock report, but remove this duplicate navigation item. -->
    <record id="restaurant_daily_product_total_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem
        id="restaurant_stock_request_menu"
        name="Stock Requests"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_request_action"
        sequence="20"
        groups="restaurant_core.group_restaurant_central_storekeeper,restaurant_core.group_restaurant_purchasing,restaurant_core.group_restaurant_operations_manager,restaurant_core.group_restaurant_owner,base.group_system"/>

    <!-- Replace legacy menu groups explicitly so upgrades also remove branch access. -->
    <record id="restaurant_stock_request_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('restaurant_core.group_restaurant_central_storekeeper'),
            ref('restaurant_core.group_restaurant_purchasing'),
            ref('restaurant_core.group_restaurant_operations_manager'),
            ref('restaurant_core.group_restaurant_owner'),
            ref('base.group_system'),
        ])]"/>
    </record>

    <menuitem
        id="restaurant_stock_branch_request_menu"
        name="Requests"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_branch_request_action"
        sequence="12"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager"/>

    <record id="restaurant_stock_branch_request_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('restaurant_core.group_restaurant_stockkeeper'),
            ref('restaurant_core.group_restaurant_branch_manager'),
        ])]"/>
    </record>

    <menuitem
        id="restaurant_stock_incoming_menu"
        name="Incoming Deliveries"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_incoming_action"
        sequence="20"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager"/>
        
    <menuitem
        id="restaurant_stock_products_menu"
        name="Products"
        parent="restaurant_stock_menu_root"
        action="restaurant_product_action"
        sequence="30"
        groups="restaurant_core.group_restaurant_central_storekeeper,base.group_system"/>

    <menuitem
        id="restaurant_stock_product_categories_menu"
        name="Product Categories"
        parent="restaurant_stock_menu_root"
        action="restaurant_product_category_action"
        sequence="31"
        groups="restaurant_core.group_restaurant_central_storekeeper,base.group_system"/>

    <!-- Product Category is selected directly on the Product form.  Keep the
         old XML ID inactive so upgrades remove the redundant category flow
         without deleting any native product.category records or references. -->
    <record id="restaurant_stock_product_categories_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem
        id="restaurant_current_stock_menu"
        name="Current Stock"
        parent="restaurant_stock_menu_root"
        action="restaurant_current_stock_action"
        sequence="5"
        groups="restaurant_core.group_restaurant_stockkeeper,restaurant_core.group_restaurant_branch_manager,restaurant_core.group_restaurant_central_storekeeper"/>

    <menuitem
        id="restaurant_stock_distribution_menu"
        name="Daily Distributions"
        parent="restaurant_stock_menu_root"
        action="restaurant_stock_distribution_action"
        sequence="15"
        groups="restaurant_core.group_restaurant_operations_manager,restaurant_core.group_restaurant_owner" />

    <!-- Explicit replacement removes legacy Stockkeeper/Central menu links. -->
    <record id="restaurant_stock_distribution_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('restaurant_core.group_restaurant_operations_manager'),
            ref('restaurant_core.group_restaurant_owner'),
        ])]"/>
    </record>

</odoo>
