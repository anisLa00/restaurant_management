<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_current_stock_view_list" model="ir.ui.view">
        <field name="name">restaurant.current.stock.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Current Stock"
                  create="0"
                  edit="0"
                  delete="0">

                <field name="name" string="Product"/>

                <field name="default_code"
                       string="Reference"
                       optional="hide"/>

                <field name="restaurant_stock_location_name"
                       string="Location"/>

                <field name="restaurant_stock_on_hand"
                       string="On Hand"/>

                <field name="restaurant_stock_received_today"
                       string="Received Today"/>

                <field name="restaurant_stock_consumption"
                       string="Consumption"/>

                <field name="restaurant_stock_consumption_mirdif"
                       string="Mirdif"
                       groups="restaurant_core.group_restaurant_central_storekeeper"/>

                <field name="restaurant_stock_consumption_jafilya"
                       string="Jafilya"
                       groups="restaurant_core.group_restaurant_central_storekeeper"/>

                <field name="restaurant_stock_consumption_global_village"
                       string="Global Village"
                       groups="restaurant_core.group_restaurant_central_storekeeper"/>

                <field name="restaurant_stock_waste"
                       string="Waste"/>

                <field name="restaurant_stock_damaged"
                       string="Damaged"/>

                <field name="restaurant_stock_available"
                       string="Available"
                       groups="restaurant_core.group_restaurant_central_storekeeper"/>

                <field name="uom_id"
                       string="UoM"/>
            </list>
        </field>
    </record>

    <record id="restaurant_current_stock_action"
            model="ir.actions.act_window">
        <field name="name">Current Stock</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="domain">
            [('active', '=', True), ('is_storable', '=', True)]
        </field>
    </record>

    <record id="restaurant_current_stock_action_view_list"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id"
               ref="restaurant_current_stock_view_list"/>
        <field name="act_window_id"
               ref="restaurant_current_stock_action"/>
    </record>

</odoo>
