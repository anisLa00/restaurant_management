<odoo>

    <record id="restaurant_stock_request_view_list" model="ir.ui.view">
        <field name="name">restaurant.stock.request.view.list</field>
        <field name="model">restaurant.stock.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'received'"
                  decoration-warning="state in ('purchase_required', 'purchasing')"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="branch_id"/>
                <field name="requested_by_id"/>
                <field name="central_storekeeper_id" optional="hide"/>
                <field name="purchasing_officer_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>


    <record id="restaurant_stock_request_view_form" model="ir.ui.view">
        <field name="name">restaurant.stock.request.view.form</field>
        <field name="model">restaurant.stock.request</field>

        <field name="arch" type="xml">
            <form string="Stock Request">

                <header>

                    <!-- Branch Stockkeeper -->
                    <button name="action_submit"
                            type="object"
                            string="Submit to Central Store"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="restaurant_core.group_restaurant_stockkeeper"/>

                    <button name="action_confirm_branch_receipt"
                            type="object"
                            string="Confirm Branch Receipt"
                            class="btn-primary"
                            invisible="state != 'dispatched'"
                            groups="restaurant_core.group_restaurant_stockkeeper"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state != 'draft'"
                            groups="restaurant_core.group_restaurant_stockkeeper"/>


                    <!-- Central Storekeeper -->
                    <button name="action_prepare_transfer"
                            type="object"
                            string="Prepare from Central Stock"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_central_storekeeper"/>

                    <button name="action_require_purchase"
                            type="object"
                            string="Send to Purchasing"
                            invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_central_storekeeper"/>

                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_central_storekeeper"/>

                    <button name="action_receive_central"
                            type="object"
                            string="Verify Central Receipt"
                            class="btn-primary"
                            invisible="state != 'purchasing'"
                            groups="restaurant_core.group_restaurant_central_storekeeper"/>

                    <button name="action_dispatch"
                            type="object"
                            string="Dispatch to Branch"
                            class="btn-primary"
                            invisible="state not in ('transfer_ready', 'central_received')"
                            groups="restaurant_core.group_restaurant_central_storekeeper"/>


                    <!-- Purchasing -->
                    <button name="action_start_purchasing"
                            type="object"
                            string="Create Purchase Order"
                            class="btn-primary"
                            invisible="state != 'purchase_required'"
                            groups="restaurant_core.group_restaurant_purchasing"/>


                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,transfer_ready,purchase_required,purchasing,central_received,dispatched,received"/>
                </header>


                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>


                    <group>
                        <group string="Request">
                            <field name="branch_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                                   
                            <field
                                    name="dispatch_picking_id"
                                    readonly="1"
                                    invisible="not dispatch_picking_id"/>

                            <field
                                    name="receipt_picking_id"
                                    readonly="1"
                                    invisible="not receipt_picking_id" />

                            <field name="vendor_id"
                                   readonly="state != 'purchase_required'"
                                   invisible="state not in ('purchase_required', 'purchasing', 'central_received', 'dispatched', 'received')"
                                   options="{'no_create': True}"/>

                            <field name="purchase_order_id"
                                   readonly="1"
                                   invisible="not purchase_order_id"/>

                            <field name="purchase_receipt_ids"
                                   widget="many2many_tags"
                                   readonly="1"
                                   invisible="not purchase_receipt_ids"/>

                            <field name="request_date"
                                   readonly="state != 'draft'"/>

                            <field name="requested_by_id"/>
                        </group>

                        <group string="Workflow Responsibility">
                            <field name="central_storekeeper_id"/>
                            <field name="purchasing_officer_id"/>
                            <field name="dispatched_by_id"/>
                            <field name="branch_received_by_id"/>

                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>


                    <notebook>

                        <page string="Requested Items">

                            <field name="line_ids">
                                <list editable="bottom">

                                    <field name="product_id"
                                           options="{'no_create': True}"
                                           readonly="parent.state != 'draft'"/>

                                    <field name="uom_id"/>

                                    <field name="requested_qty"
                                           readonly="parent.state != 'draft'"/>

                                    <field name="transfer_qty"
                                           readonly="parent.state != 'submitted'"/>

                                    <field name="purchase_qty"
                                           readonly="parent.state != 'submitted'"/>

                                    <field name="central_received_qty"
                                           readonly="1"/>

                                    <field name="dispatched_qty"
                                           readonly="parent.state not in ('transfer_ready', 'central_received')"/>

                                    <field name="branch_received_qty"
                                           readonly="parent.state != 'dispatched'"/>

                                    <field name="difference_qty"/>

                                    <field name="note"/>

                                </list>
                            </field>

                        </page>


                        <page string="Notes">

                            <group>

                                <field name="branch_note"
                                       readonly="state != 'draft'"/>

                                <field name="central_note"
                                       readonly="state not in ('submitted', 'transfer_ready', 'purchase_required', 'purchasing', 'central_received')"/>

                                <field name="purchasing_note"
                                       readonly="state not in ('purchase_required', 'purchasing')"/>

                                <field name="receipt_note"
                                       readonly="state != 'dispatched'"/>

                            </group>

                        </page>


                        <page string="Audit">
                            <group>
                                <field name="create_uid"/>
                                <field name="create_date"/>
                                <field name="write_uid"/>
                                <field name="write_date"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>


    <record id="restaurant_stock_request_view_search" model="ir.ui.view">
        <field name="name">restaurant.stock.request.view.search</field>
        <field name="model">restaurant.stock.request</field>

        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="branch_id"/>
                <field name="request_date"/>
                <field name="requested_by_id"/>
                <field name="state"/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter name="submitted"
                        string="Central Review"
                        domain="[('state','=','submitted')]"/>

                <filter name="purchase_required"
                        string="Purchase Required"
                        domain="[('state','=','purchase_required')]"/>

                <filter name="purchasing"
                        string="Purchasing"
                        domain="[('state','=','purchasing')]"/>

                <filter name="dispatched"
                        string="Dispatched"
                        domain="[('state','=','dispatched')]"/>

                <filter name="received"
                        string="Received"
                        domain="[('state','=','received')]"/>

                <separator/>

                <filter name="request_date_filter"
                        string="Request Date"
                        date="request_date"/>

                <group>
                    <filter name="group_branch"
                            string="Branch"
                            context="{'group_by':'branch_id'}"/>

                    <filter name="group_state"
                            string="State"
                            context="{'group_by':'state'}"/>

                    <filter name="group_date"
                            string="Date"
                            context="{'group_by':'request_date:day'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="restaurant_stock_request_action" model="ir.actions.act_window">
        <field name="name">Stock Requests</field>
        <field name="res_model">restaurant.stock.request</field>
        <field name="view_mode">list,form</field>
    </record>

   </odoo>
