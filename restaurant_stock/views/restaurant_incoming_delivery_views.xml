<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="restaurant_incoming_delivery_view_list" model="ir.ui.view">
        <field name="name">restaurant.incoming.delivery.list</field>
        <field name="model">restaurant.incoming.delivery</field>
        <field name="arch" type="xml">
            <list string="Incoming Deliveries" create="0" edit="0" delete="0"
                  decoration-success="delivery_status == 'received'"
                  decoration-warning="delivery_status == 'delivered'">
                <field name="name"/>
                <field name="delivery_type"/>
                <field name="delivery_date"/>
                <field name="branch_id"/>
                <field name="delivery_status" widget="badge"/>
                <button name="action_open_delivery" type="object"
                        string="Review / Receive" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="restaurant_incoming_delivery_view_form" model="ir.ui.view">
        <field name="name">restaurant.incoming.delivery.form</field>
        <field name="model">restaurant.incoming.delivery</field>
        <field name="arch" type="xml">
            <form string="Incoming Delivery" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_delivery" type="object"
                            string="Review / Receive" class="btn-primary"/>
                    <field name="delivery_status" widget="statusbar"
                           statusbar_visible="requested,confirmed,delivered,received"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="delivery_type"/>
                        <field name="delivery_date"/>
                        <field name="branch_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_stock_incoming_action" model="ir.actions.act_window">
        <field name="name">Incoming Deliveries</field>
        <field name="res_model">restaurant.incoming.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="restaurant_stock_incoming_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="restaurant_incoming_delivery_view_list"/>
        <field name="act_window_id" ref="restaurant_stock_incoming_action"/>
    </record>

    <record id="restaurant_stock_incoming_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="restaurant_incoming_delivery_view_form"/>
        <field name="act_window_id" ref="restaurant_stock_incoming_action"/>
    </record>

</odoo>
