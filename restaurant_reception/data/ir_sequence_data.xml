<odoo noupdate="1">
    <record id="sequence_daily_closing" model="ir.sequence">
        <field name="name">Restaurant Daily Closing</field>
        <field name="code">restaurant.daily.closing</field>
        <field name="prefix">RDC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_waiter_sales_closing" model="ir.sequence">
        <field name="name">Waiter Sales and Tips Closing</field>
        <field name="code">restaurant.waiter.sales.closing</field>
        <field name="prefix">WST/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_leave_request" model="ir.sequence">
        <field name="name">Restaurant Leave Request</field>
        <field name="code">restaurant.leave.request</field>
        <field name="prefix">RLR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_employee_number" model="ir.sequence">
        <field name="name">Restaurant Employee Number</field>
        <field name="code">restaurant.employee.number</field>
        <field name="prefix">EMP-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
