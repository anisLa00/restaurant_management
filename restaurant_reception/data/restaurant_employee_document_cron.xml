<odoo noupdate="1">
    <record id="ir_cron_employee_document_expiry" model="ir.cron">
        <field name="name">HR Documents: Check Expiry Dates</field>
        <field name="model_id" ref="model_restaurant_employee_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_document_expiry()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
