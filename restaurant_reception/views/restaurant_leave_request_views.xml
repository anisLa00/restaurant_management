<odoo>
    <record id="restaurant_leave_request_view_list" model="ir.ui.view">
        <field name="name">restaurant.leave.request.view.list</field>
        <field name="model">restaurant.leave.request</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected' or sync_status == 'error'"
                  decoration-warning="state == 'submitted_to_hr'">
                <field name="reference"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="leave_kind" widget="badge"/>
                <field name="manager_approved_by" optional="show"/>
                <field name="hr_reviewed_by" optional="hide"/>
                <field name="sync_status" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_leave_request_view_form" model="ir.ui.view">
        <field name="name">restaurant.leave.request.view.form</field>
        <field name="model">restaurant.leave.request</field>
        <field name="arch" type="xml">
            <form string="Employee Leave Request">
                <header>
                    <button name="action_submit_to_hr" type="object"
                            string="Approve &amp; Submit to HR" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="restaurant_core.group_restaurant_branch_manager"/>
                    <button name="action_approve" type="object"
                            string="Approve Leave" class="btn-primary"
                            invisible="state != 'submitted_to_hr' or not can_review_hr or sync_status == 'error'"
                            groups="restaurant_core.group_restaurant_hr"/>
                    <button name="action_retry_sync" type="object"
                            string="Retry Sync" class="btn-primary"
                            invisible="state != 'submitted_to_hr' or not can_review_hr or sync_status != 'error'"
                            groups="restaurant_core.group_restaurant_hr"/>
                    <button name="action_return_to_manager" type="object"
                            string="Return to Manager"
                            invisible="state != 'submitted_to_hr' or not can_review_hr"
                            groups="restaurant_core.group_restaurant_hr"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted_to_hr' or not can_review_hr"
                            groups="restaurant_core.group_restaurant_hr"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted_to_hr,approved,rejected"/>
                </header>
                <sheet>
                    <field name="can_review_hr" invisible="1"/>
                    <field name="company_id" invisible="1"/>

                    <div class="alert alert-danger" role="alert"
                         invisible="sync_status != 'error'">
                        <strong>Official Time Off sync failed.</strong>
                        The request remains awaiting HR and can be retried after correction.
                        <field name="sync_error" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        The branch manager records the employee's signed paper request and
                        approves it before sending it to HR.
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_official_leave" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="not official_leave_id"
                                groups="restaurant_core.group_restaurant_hr,base.group_system">
                            <field name="official_leave_id" widget="statinfo"
                                   string="Time Off"/>
                        </button>
                    </div>

                    <group>
                        <group string="Employee Request">
                            <field name="reference"/>
                            <field name="branch_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="employee_id" readonly="state != 'draft'"
                                   domain="[('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="leave_kind" readonly="state != 'draft'"/>
                            <field name="request_date_from" readonly="state != 'draft'"/>
                            <field name="request_date_to" readonly="state != 'draft'"/>
                        </group>
                        <group string="Signed Form">
                            <field name="request_document" filename="request_document_name"
                                   readonly="state != 'draft'"/>
                            <field name="request_document_name" invisible="1"/>
                            <field name="entered_by"/>
                            <field name="sync_status" widget="badge"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="request_details" string="Request and Review">
                            <group string="Employee Reason">
                                <field name="reason" readonly="state != 'draft'"
                                       nolabel="1"
                                       placeholder="Reason written on the signed leave form..."/>
                            </group>
                            <group string="Branch Manager">
                                <field name="manager_note" readonly="state != 'draft'"
                                       nolabel="1"
                                       placeholder="Manager staffing review and approval note..."/>
                            </group>
                            <group string="HR">
                                <field name="official_leave_type_id"
                                       readonly="state != 'submitted_to_hr' or not can_review_hr"
                                       options="{'no_create': True}"/>
                                <field name="hr_note"
                                       readonly="state != 'submitted_to_hr' or not can_review_hr"
                                       nolabel="1" placeholder="HR policy and balance review..."/>
                                <field name="decision_reason"
                                       readonly="state != 'submitted_to_hr' or not can_review_hr"
                                       nolabel="1"
                                       placeholder="Required for rejection or return to Manager..."/>
                                <field name="last_hr_return_reason" readonly="1"
                                       invisible="not last_hr_return_reason"/>
                            </group>
                        </page>
                        <page name="audit" string="Approval History">
                            <group>
                                <group string="Manager Approval">
                                    <field name="manager_approved_by"/>
                                    <field name="manager_approved_at"/>
                                </group>
                                <group string="HR Decision">
                                    <field name="hr_reviewed_by"/>
                                    <field name="hr_reviewed_at"/>
                                </group>
                                <group string="Last HR Return">
                                    <field name="hr_return_count"/>
                                    <field name="hr_returned_by"/>
                                    <field name="hr_returned_at"/>
                                </group>
                                <group string="Sync Audit">
                                    <field name="sync_attempt_count"/>
                                    <field name="last_sync_attempt_by"/>
                                    <field name="last_sync_attempt_at"/>
                                    <field name="official_leave_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_leave_request_view_search" model="ir.ui.view">
        <field name="name">restaurant.leave.request.view.search</field>
        <field name="model">restaurant.leave.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="leave_kind"/>
                <field name="state"/>
                <filter name="draft" string="Manager Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="submitted_to_hr" string="Awaiting HR"
                        domain="[('state', '=', 'submitted_to_hr')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter name="sync_error" string="Sync Error"
                        domain="[('sync_status', '=', 'error')]"/>
                <filter name="request_date" string="Leave Date" date="request_date_from"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_kind" string="Leave Type"
                            context="{'group_by': 'leave_kind'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_leave_request_manager_action" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">restaurant.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a signed leave request</p>
            <p>The branch manager records and approves the employee's paper request before HR review.</p>
        </field>
    </record>

    <record id="restaurant_leave_request_hr_awaiting_action" model="ir.actions.act_window">
        <field name="name">Leave Awaiting HR</field>
        <field name="res_model">restaurant.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted_to_hr')]</field>
        <field name="context">{'create': False, 'search_default_group_branch': 1}</field>
    </record>

    <record id="restaurant_leave_request_hr_all_action" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">restaurant.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_group_state': 1}</field>
    </record>
</odoo>
