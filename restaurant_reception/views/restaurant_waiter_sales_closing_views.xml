<odoo>
    <record id="restaurant_waiter_sales_closing_view_list" model="ir.ui.view">
        <field name="name">restaurant.waiter.sales.closing.view.list</field>
        <field name="model">restaurant.waiter.sales.closing</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'closed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="business_date"/>
                <field name="branch_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="bill_count" sum="Bills"/>
                <field name="guest_count" sum="Guests"/>
                <field name="total_sales" sum="Total Sales"/>
                <field name="total_tips" sum="Tips"/>
                <field name="review_count" sum="Reviews"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_waiter_sales_closing_view_form" model="ir.ui.view">
        <field name="name">restaurant.waiter.sales.closing.view.form</field>
        <field name="model">restaurant.waiter.sales.closing</field>
        <field name="arch" type="xml">
            <form string="Waiter Sales &amp; Tips">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state not in ('draft','correction')"
                            groups="restaurant_core.group_restaurant_reception"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_branch_manager"/>
                    <button name="action_return_to_draft" type="object"
                            string="Return for Correction"
                            invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_branch_manager"/>
                    <button name="action_open_correction" type="object"
                            string="Open Closed Correction"
                            invisible="state != 'closed'"
                            groups="restaurant_core.group_restaurant_branch_manager"/>
                    <button name="action_refresh_waiters" type="object"
                            string="Refresh Staff Rows"
                            invisible="state not in ('draft','correction')"
                            groups="restaurant_core.group_restaurant_reception"/>
                    <button name="action_download_waiter_table_pdf" type="object"
                            string="Download Waiter Table PDF"
                            invisible="state != 'closed'"
                            groups="restaurant_core.group_restaurant_reception,restaurant_core.group_restaurant_branch_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            confirm="Cancel this draft waiter closing?"
                            invisible="state != 'draft'"
                            groups="restaurant_core.group_restaurant_reception"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            confirm="Cancel this submitted waiter closing?"
                            invisible="state != 'submitted'"
                            groups="restaurant_core.group_restaurant_branch_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,correction,submitted,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'correction'">
                        This is the same sheet reopened for correction. Update the
                        incorrect entries, submit it again, and let Management close it.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not reopen_count">
                        <strong>Updated after correction.</strong>
                        The reason and revision history are recorded below and the next
                        PDF will be marked Updated.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Business Day">
                            <field name="branch_id" readonly="state not in ('draft','correction')"
                                   options="{'no_create': True}"/>
                            <field name="business_date" readonly="state not in ('draft','correction')"/>
                            <field name="reception_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Day Totals">
                            <field name="total_sales"/>
                            <field name="guest_count"/>
                            <field name="cash_tips"/>
                            <field name="card_tips"/>
                            <field name="total_tips"/>
                            <field name="review_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="bills" string="Bills &amp; Waiters">
                            <div class="alert alert-info" role="alert">
                                Waiters are added automatically. Open Orders on a waiter and enter every table separately. Totals and the Bill / Tip sequence are calculated automatically. Use Add a line only for a Pickup or Delivery daily total.
                            </div>
                            <field name="bill_ids"
                                   context="{'default_is_daily_total': True, 'default_service_type': 'pickup'}"
                                   readonly="state not in ('draft','correction')">
                                <list editable="bottom">
                                    <field name="is_daily_total" column_invisible="True"/>
                                    <field name="is_auto_waiter" column_invisible="True"/>
                                    <field name="entry_mode" column_invisible="True"/>
                                    <field name="service_type" readonly="is_auto_waiter"/>
                                    <field name="employee_id"
                                           domain="[('company_id', '=', parent.company_id), ('restaurant_branch_id', '=', parent.branch_id), ('active', '=', True), ('job_id.name', 'ilike', 'waiter')]"
                                           options="{'no_create': True, 'no_open': True}"
                                           required="service_type == 'dine_in'"
                                           readonly="is_auto_waiter or service_type != 'dine_in'"/>
                                    <button name="action_open_orders" type="object"
                                            string="Orders" class="btn-link"
                                            invisible="not is_auto_waiter"/>
                                    <field name="table_references" string="Tables"
                                           readonly="1" optional="show"/>
                                    <field name="guest_counts" string="Guests per Order"
                                           readonly="1" optional="show"/>
                                    <field name="order_breakdown" string="Bills / Tips"
                                           readonly="1" optional="show"/>
                                    <field name="bill_count" sum="Bills"
                                           readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                    <field name="table_count" sum="Tables"
                                           readonly="service_type != 'dine_in' or (is_auto_waiter and entry_mode == 'order_details')"
                                           optional="hide"/>
                                    <field name="table_reference"
                                           optional="hide"
                                           readonly="is_daily_total or service_type != 'dine_in'"/>
                                    <field name="bill_reference" optional="hide"
                                           readonly="is_daily_total"/>
                                    <field name="guest_count"
                                           readonly="service_type != 'dine_in' or (is_auto_waiter and entry_mode == 'order_details')"
                                           optional="hide"
                                           sum="Guests"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="bill_amount" string="Total (VAT Included)"
                                           sum="Bill Sales (VAT Included)"
                                           readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                    <field name="cash_tip_amount" sum="Cash Tips"
                                           readonly="is_auto_waiter and entry_mode == 'order_details'"
                                           optional="hide"/>
                                    <field name="card_tip_amount" sum="Card Tips"
                                           readonly="is_auto_waiter and entry_mode == 'order_details'"
                                           optional="hide"/>
                                    <field name="tip_total" sum="Tips" readonly="1"/>
                                    <field name="tip_percentage" string="Tips %" readonly="1"/>
                                    <field name="review_count" sum="Reviews"
                                           readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                    <field name="note" optional="show"/>
                                    <field name="entered_by_id" optional="hide"/>
                                    <field name="entered_at" optional="hide"/>
                                </list>
                                <form string="Bill">
                                    <group>
                                        <group string="Bill &amp; Service">
                                            <field name="is_daily_total" invisible="1"/>
                                            <field name="is_auto_waiter" invisible="1"/>
                                            <field name="entry_mode"
                                                   invisible="not is_auto_waiter"
                                                   readonly="order_ids"/>
                                            <field name="service_type" readonly="is_auto_waiter"/>
                                            <field name="bill_reference" invisible="is_daily_total"/>
                                            <field name="employee_id"
                                                   domain="[('company_id', '=', parent.company_id), ('restaurant_branch_id', '=', parent.branch_id), ('active', '=', True), ('job_id.name', 'ilike', 'waiter')]"
                                                   options="{'no_create': True, 'no_open': True}"
                                                   required="service_type == 'dine_in'"
                                                   readonly="is_auto_waiter or service_type != 'dine_in'"/>
                                            <field name="bill_count"
                                                   readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                            <field name="table_count"
                                                   readonly="service_type != 'dine_in' or (is_auto_waiter and entry_mode == 'order_details')"/>
                                            <field name="table_reference"
                                                   invisible="is_daily_total"
                                                   readonly="service_type != 'dine_in'"/>
                                            <field name="guest_count"
                                                   readonly="service_type != 'dine_in' or (is_auto_waiter and entry_mode == 'order_details')"/>
                                            <field name="bill_amount"
                                                   readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                        </group>
                                        <group string="Tips &amp; Review">
                                            <field name="cash_tip_amount"
                                                   readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                            <field name="card_tip_amount"
                                                   readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                            <field name="tip_total"/>
                                            <field name="tip_percentage"/>
                                            <field name="review_count"
                                                   readonly="is_auto_waiter and entry_mode == 'order_details'"/>
                                            <field name="entered_by_id"/>
                                            <field name="entered_at"/>
                                        </group>
                                    </group>
                                    <field name="order_ids"
                                           invisible="entry_mode != 'order_details'">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="reference" optional="hide"/>
                                            <field name="pos_reference" optional="show"/>
                                            <field name="table_reference"/>
                                            <field name="guest_count" sum="Guests"/>
                                            <field name="currency_id" column_invisible="True"/>
                                            <field name="bill_amount" sum="Bills"/>
                                            <field name="cash_tip_amount" sum="Cash Tips"/>
                                            <field name="card_tip_amount" sum="Card Tips"/>
                                            <field name="tip_total" sum="Tips" readonly="1"/>
                                            <field name="review_count" sum="Reviews"/>
                                            <field name="note" optional="show"/>
                                        </list>
                                    </field>
                                    <field name="note"/>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="dine_in_sales"/>
                                <field name="pickup_sales"/>
                                <field name="delivery_sales"/>
                                <field name="total_sales"/>
                                <field name="bill_count"/>
                            </group>
                        </page>

                        <page name="summary" string="Waiter Summary">
                            <div class="alert alert-info" role="alert">
                                This summary is generated automatically from the bill rows and ranks waiters by Total Sales (VAT Included), highest first. Tip percentage is reporting only and does not calculate entitlement or payout.
                            </div>
                            <field name="summary_line_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="summary_type" column_invisible="True"/>
                                    <field name="sales_rank" string="Rank"
                                           invisible="summary_type != 'waiter'"/>
                                    <field name="summary_name"/>
                                    <field name="table_count" sum="Tables"/>
                                    <field name="table_references" optional="hide"/>
                                    <field name="guest_counts" optional="hide"/>
                                    <field name="order_breakdown" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="bill_count" sum="Bills"/>
                                    <field name="guest_count" sum="Guests"/>
                                    <field name="sales_amount" sum="Total"/>
                                    <field name="cash_tip_amount" sum="Cash Tips" optional="show"/>
                                    <field name="card_tip_amount" sum="Card Tips" optional="show"/>
                                    <field name="tips_amount" sum="Tips"/>
                                    <field name="tip_percentage" string="Tips %"/>
                                    <field name="review_count" sum="Reviews"/>
                                </list>
                            </field>
                        </page>

                        <page name="notes" string="Notes &amp; Audit">
                            <group>
                                <group string="Notes">
                                    <field name="notes" readonly="state not in ('draft','correction')"/>
                                    <field name="correction_reason"
                                           readonly="state not in ('submitted','closed')"
                                           placeholder="Required before opening a correction..."/>
                                    <field name="last_correction_reason" readonly="1"
                                           invisible="not reopen_count"/>
                                </group>
                                <group string="Audit">
                                    <field name="submitted_by_id"/>
                                    <field name="submitted_at"/>
                                    <field name="closed_by_id"/>
                                    <field name="closed_at"/>
                                    <field name="last_reopened_by_id"/>
                                    <field name="last_reopened_at"/>
                                    <field name="reopen_count"/>
                                    <field name="first_closed_by_id"/>
                                    <field name="first_closed_at"/>
                                    <field name="cancelled_by_id"/>
                                    <field name="cancelled_at"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_waiter_sales_bill_orders_view_form" model="ir.ui.view">
        <field name="name">restaurant.waiter.sales.bill.orders.view.form</field>
        <field name="model">restaurant.waiter.sales.bill</field>
        <field name="arch" type="xml">
            <form string="Waiter Orders" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id" options="{'no_open': True}"/></h1>
                    </div>
                    <field name="is_auto_waiter" invisible="1"/>
                    <field name="is_daily_total" invisible="1"/>
                    <field name="service_type" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-info" role="alert"
                         invisible="entry_mode != 'order_details'">
                        Add one line for every order or table. Tables, guests, Bills,
                        Tips and Reviews are totalled automatically on the waiter row.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="entry_mode != 'daily_total'">
                        This is a preserved historical Daily Total. Its old totals are
                        not reinterpreted as separate orders.
                    </div>
                    <group>
                        <group string="Waiter Day">
                            <field name="entry_mode" readonly="order_ids or state not in ('draft','correction')"/>
                            <field name="table_references" readonly="1"/>
                            <field name="guest_counts" readonly="1"/>
                            <field name="order_breakdown" readonly="1"/>
                        </group>
                        <group string="Calculated Totals">
                            <field name="bill_count"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="table_count"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="guest_count"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="bill_amount"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="cash_tip_amount"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="card_tip_amount"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                            <field name="tip_total" readonly="1"/>
                            <field name="tip_percentage" readonly="1"/>
                            <field name="review_count"
                                   readonly="entry_mode == 'order_details' or state not in ('draft','correction')"/>
                        </group>
                    </group>
                    <field name="order_ids"
                           invisible="entry_mode != 'order_details'"
                           readonly="state not in ('draft','correction')">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="reference" optional="hide"/>
                            <field name="pos_reference" optional="show"/>
                            <field name="table_reference"/>
                            <field name="guest_count" sum="Guests"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="bill_amount" sum="Bills"/>
                            <field name="cash_tip_amount" sum="Cash Tips"/>
                            <field name="card_tip_amount" sum="Card Tips"/>
                            <field name="tip_total" sum="Tips" readonly="1"/>
                            <field name="review_count" sum="Reviews"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>
                    <field name="note" readonly="state not in ('draft','correction')"/>
                </sheet>
                <footer>
                    <button string="Save &amp; Close" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="restaurant_waiter_sales_closing_view_search" model="ir.ui.view">
        <field name="name">restaurant.waiter.sales.closing.view.search</field>
        <field name="model">restaurant.waiter.sales.closing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="business_date"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="date" string="Business Date" date="business_date"/>
                <group>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'business_date:day'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_waiter_sales_closing_action" model="ir.actions.act_window">
        <field name="name">Waiter Sales &amp; Tips</field>
        <field name="res_model">restaurant.waiter.sales.closing</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the branch waiter closing</p>
            <p>Enter each bill once, review the generated waiter summary, then submit it for management close.</p>
        </field>
    </record>
</odoo>
