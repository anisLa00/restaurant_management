<odoo>
    <record id="restaurant_employee_document_view_search" model="ir.ui.view">
        <field name="name">restaurant.employee.document.view.search</field>
        <field name="model">restaurant.employee.document</field>
        <field name="arch" type="xml">
            <search string="Employee Documents">
                <field name="employee_id"/>
                <field name="employee_number"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="branch_id"/>
                <filter name="expiring" string="Expiring Soon"
                        domain="[('status', '=', 'expiring')]"/>
                <filter name="expired" string="Expired"
                        domain="[('status', '=', 'expired')]"/>
                <separator/>
                <filter name="group_by_employee" string="Employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_type" string="Document Type"
                        context="{'group_by': 'document_type_id'}"/>
                <filter name="group_by_branch" string="Branch"
                        context="{'group_by': 'branch_id'}"/>
                <filter name="group_by_status" string="Status"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="restaurant_employee_document_view_list" model="ir.ui.view">
        <field name="name">restaurant.employee.document.view.list</field>
        <field name="model">restaurant.employee.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring'"
                  decoration-success="status == 'valid'">
                <field name="employee_number" optional="show"/>
                <field name="employee_id"/>
                <field name="branch_id" optional="show"/>
                <field name="document_type_id"/>
                <field name="document_number" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="status" widget="badge"/>
                <field name="responsible_user_id" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="restaurant_employee_document_view_form" model="ir.ui.view">
        <field name="name">restaurant.employee.document.view.form</field>
        <field name="model">restaurant.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="no_expiry,valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_number" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="document_type_id" options="{'no_create_edit': True}"/>
                            <field name="document_number"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="responsible_user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Secure Copy">
                        <field name="document_file" filename="document_filename"/>
                        <field name="document_filename" invisible="1"/>
                        <field name="notes" placeholder="Verification or renewal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_employee_document_action" model="ir.actions.act_window">
        <field name="name">Employee Documents</field>
        <field name="res_model">restaurant.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="restaurant_employee_document_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload an employee document</p>
            <p>Track passports, visas, IDs, contracts and certificates with expiry reminders.</p>
        </field>
    </record>

    <record id="restaurant_employee_document_expiring_action" model="ir.actions.act_window">
        <field name="name">Expiring Documents</field>
        <field name="res_model">restaurant.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'expiring')]</field>
        <field name="search_view_id" ref="restaurant_employee_document_view_search"/>
    </record>

    <record id="restaurant_employee_document_expired_action" model="ir.actions.act_window">
        <field name="name">Expired Documents</field>
        <field name="res_model">restaurant.employee.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'expired')]</field>
        <field name="search_view_id" ref="restaurant_employee_document_view_search"/>
    </record>

    <record id="restaurant_employee_document_type_view_list" model="ir.ui.view">
        <field name="name">restaurant.employee.document.type.view.list</field>
        <field name="model">restaurant.employee.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="required_for_employee"/>
                <field name="expiry_required"/>
                <field name="alert_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="restaurant_employee_document_type_view_form" model="ir.ui.view">
        <field name="name">restaurant.employee.document.type.view.form</field>
        <field name="model">restaurant.employee.document.type</field>
        <field name="arch" type="xml">
            <form string="Employee Document Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="required_for_employee"/>
                        <field name="expiry_required"/>
                        <field name="alert_days"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_employee_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">restaurant.employee.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
