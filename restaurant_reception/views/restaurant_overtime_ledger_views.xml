<odoo>
    <record id="restaurant_overtime_ledger_view_list" model="ir.ui.view">
        <field name="name">restaurant.overtime.ledger.view.list</field>
        <field name="model">restaurant.overtime.ledger</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="attendance_date"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="company_id" optional="hide"/>
                <field name="hours" widget="float_time" sum="Approved Overtime"/>
                <field name="approved_by"/>
                <field name="approved_at"/>
                <field name="source_entry_id"/>
            </list>
        </field>
    </record>

    <record id="restaurant_overtime_ledger_view_form" model="ir.ui.view">
        <field name="name">restaurant.overtime.ledger.view.form</field>
        <field name="model">restaurant.overtime.ledger</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" string="Approved Overtime">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id"/>
                            <field name="branch_id"/>
                            <field name="attendance_date"/>
                            <field name="hours" widget="float_time"/>
                        </group>
                        <group string="Approval Audit">
                            <field name="approved_by"/>
                            <field name="approved_at"/>
                            <field name="source_entry_id"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_overtime_ledger_view_search" model="ir.ui.view">
        <field name="name">restaurant.overtime.ledger.view.search</field>
        <field name="model">restaurant.overtime.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="company_id"/>
                <field name="attendance_date"/>
                <filter name="date" string="Attendance Date" date="attendance_date"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'attendance_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_hr_approved_overtime_action" model="ir.actions.act_window">
        <field name="name">Approved Overtime</field>
        <field name="res_model">restaurant.overtime.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_group_branch': 1}</field>
    </record>
</odoo>
