<odoo>
    <record id="restaurant_shift_roster_view_list" model="ir.ui.view">
        <field name="name">restaurant.shift.roster.view.list</field>
        <field name="model">restaurant.shift.roster</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'published'">
                <field name="month_start"/>
                <field name="month_end"/>
                <field name="branch_id"/>
                <field name="company_id" optional="hide"/>
                <field name="published_by" optional="hide"/>
                <field name="published_at" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="restaurant_shift_roster_view_form" model="ir.ui.view">
        <field name="name">restaurant.shift.roster.view.form</field>
        <field name="model">restaurant.shift.roster</field>
        <field name="arch" type="xml">
            <form string="Monthly Shift Roster">
                <header>
                    <button name="action_populate_staff" type="object"
                            string="Populate / Refresh Staff"
                            invisible="state != 'draft'"/>
                    <button name="action_publish" type="object"
                            string="Publish Roster" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reopen" type="object"
                            string="Reopen for Changes"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="branch_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="month_start" readonly="state != 'draft'"/>
                            <field name="month_end" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Publication Audit">
                            <field name="published_by" readonly="1"/>
                            <field name="published_at" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Set each employee to Morning, Evening, or One Shift, then publish.
                        Daily Attendance Sheets will copy this schedule automatically.
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0"
                              default_group_by="staff_category_id">
                            <field name="employee_id" readonly="1"/>
                            <field name="staff_category_id" readonly="1"/>
                            <field name="job_id" optional="show"/>
                            <field name="staff_shift" string="Shift"
                                   readonly="parent.state != 'draft'"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_shift_roster_view_search" model="ir.ui.view">
        <field name="name">restaurant.shift.roster.view.search</field>
        <field name="model">restaurant.shift.roster</field>
        <field name="arch" type="xml">
            <search>
                <field name="branch_id"/>
                <field name="month_start"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <group>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_month" string="Month"
                            context="{'group_by': 'month_start:month'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_shift_roster_action" model="ir.actions.act_window">
        <field name="name">Shift Rosters</field>
        <field name="res_model">restaurant.shift.roster</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the monthly shift roster</p>
            <p>Schedule branch staff once, publish it, and Daily Attendance will use it automatically.</p>
        </field>
    </record>
</odoo>
