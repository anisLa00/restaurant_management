<odoo>
    <record id="restaurant_waiter_daily_line_view_list" model="ir.ui.view">
        <field name="name">restaurant.waiter.daily.line.view.list</field>
        <field name="model">restaurant.waiter.daily.line</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="employee_id"/><field name="closing_date"/><field name="branch_id"/><field name="closing_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="sales_amount" sum="Sales"/><field name="tips_amount" sum="Tips"/>
                <field name="tip_percentage" string="Tips (%)" optional="show"/>
                <field name="order_count" sum="Orders"/><field name="table_count" sum="Tables"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="restaurant_waiter_daily_line_view_form" model="ir.ui.view">
        <field name="name">restaurant.waiter.daily.line.view.form</field>
        <field name="model">restaurant.waiter.daily.line</field>
        <field name="arch" type="xml">
            <form string="Waiter Sales &amp; Tips" create="0">
                <sheet>
                    <group>
                        <group string="Waiter and Closing">
                            <field name="closing_id" readonly="1"/>
                            <field name="employee_id" readonly="state != 'draft'" domain="[('company_id', '=', company_id)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="branch_id"/><field name="closing_date"/><field name="state" widget="badge"/>
                            <field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Daily Performance">
                            <field name="sales_amount" readonly="state != 'draft'"/>
                            <field name="tips_amount" readonly="state != 'draft'"/>
                            <field name="tip_percentage" string="Tips (%)"/>
                            <field name="order_count" readonly="state != 'draft'"/>
                            <field name="table_count" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="note" readonly="state != 'draft'" placeholder="Waiter-specific observations..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="restaurant_waiter_daily_line_view_search" model="ir.ui.view">
        <field name="name">restaurant.waiter.daily.line.view.search</field>
        <field name="model">restaurant.waiter.daily.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="branch_id"/><field name="closing_date"/><field name="state"/>
                <filter name="confirmed" string="Confirmed Closings" domain="[('state', '=', 'confirmed')]"/>
                <filter name="date" string="Closing Date" date="closing_date"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'closing_date:day'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="restaurant_waiter_daily_line_action" model="ir.actions.act_window">
        <field name="name">Waiter Sales &amp; Tips</field>
        <field name="res_model">restaurant.waiter.daily.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Waiter sales appear here</p><p>Add waiter lines inside a draft Daily Closing.</p></field>
    </record>
</odoo>
