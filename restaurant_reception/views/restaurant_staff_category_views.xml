<odoo>
    <record id="restaurant_staff_category_view_list" model="ir.ui.view">
        <field name="name">restaurant.staff.category.view.list</field>
        <field name="model">restaurant.staff.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="restaurant_staff_category_view_form" model="ir.ui.view">
        <field name="name">restaurant.staff.category.view.form</field>
        <field name="model">restaurant.staff.category</field>
        <field name="arch" type="xml">
            <form string="Staff Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="restaurant_staff_category_action" model="ir.actions.act_window">
        <field name="name">Staff Categories</field>
        <field name="res_model">restaurant.staff.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a staff category</p>
            <p>Categories group precise employee jobs in the daily attendance sheet.</p>
        </field>
    </record>
</odoo>
