<odoo>
    <record id="restaurant_payroll_correction_view_list" model="ir.ui.view">
        <field name="name">restaurant.payroll.correction.view.list</field>
        <field name="model">restaurant.payroll.correction</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-warning="state in ('pending_carry', 'awaiting_cash')"
                  decoration-success="state in ('carried', 'cash_settled')">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="correction_date"/>
                <field name="original_status" widget="badge"/>
                <field name="corrected_status" widget="badge"/>
                <field name="allowance_amount" sum="Allowance"/>
                <field name="deduction_amount" sum="Deduction"/>
                <field name="settlement_method" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="source_payroll_batch_id" optional="show"/>
                <field name="target_payroll_batch_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="restaurant_payroll_correction_view_form" model="ir.ui.view">
        <field name="name">restaurant.payroll.correction.view.form</field>
        <field name="model">restaurant.payroll.correction</field>
        <field name="arch" type="xml">
            <form string="Payroll Attendance Correction" create="0" delete="0">
                <header>
                    <button name="action_mark_cash_settled" type="object"
                            string="Confirm Cash Settled" class="btn-primary"
                            invisible="state != 'awaiting_cash'"
                            groups="restaurant_core.group_restaurant_accountant,base.group_system"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending_carry,awaiting_cash,carried,cash_settled,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="reference" readonly="1"/></h1></div>
                    <div class="alert alert-info" role="alert">
                        This record documents a financial difference caused by an audited
                        attendance correction. It is not a payslip and does not itself move cash.
                        Accounting confirms Cash Settled only after actual delivery and receipt.
                    </div>
                    <group>
                        <group string="Source">
                            <field name="employee_id" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="correction_date" readonly="1"/>
                            <field name="attendance_entry_id" readonly="1"/>
                            <field name="attendance_month_id" readonly="1"/>
                            <field name="source_payroll_batch_id" readonly="1"/>
                        </group>
                        <group string="Calculated Difference">
                            <field name="original_status" readonly="1"/>
                            <field name="corrected_status" readonly="1"/>
                            <field name="daily_rate" readonly="1"/>
                            <field name="amount_signed" readonly="1"/>
                            <field name="allowance_amount" readonly="1"/>
                            <field name="deduction_amount" readonly="1"/>
                            <field name="settlement_method" readonly="1"/>
                            <field name="correction_note" readonly="1"/>
                        </group>
                    </group>
                    <group string="Next Payroll" invisible="settlement_method != 'next_payroll'">
                        <field name="target_payroll_batch_id" readonly="1"/>
                        <field name="target_payroll_line_id" readonly="1"/>
                    </group>
                    <group string="Cash Settlement" invisible="settlement_method != 'cash_now'">
                        <field name="cash_settlement_date"
                               readonly="state != 'awaiting_cash'"/>
                        <field name="cash_settlement_note"
                               readonly="state != 'awaiting_cash'"
                               placeholder="Cash delivery note and reference..."/>
                        <field name="cash_receipt" filename="cash_receipt_filename"
                               readonly="state != 'awaiting_cash'"/>
                        <field name="cash_receipt_filename" invisible="1"/>
                        <field name="cash_settled_by" readonly="1"/>
                        <field name="cash_settled_at" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="restaurant_payroll_correction_view_search" model="ir.ui.view">
        <field name="name">restaurant.payroll.correction.view.search</field>
        <field name="model">restaurant.payroll.correction</field>
        <field name="arch" type="xml">
            <search string="Payroll Corrections">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <filter name="pending_carry" string="Pending Next Payroll"
                        domain="[('state', '=', 'pending_carry')]"/>
                <filter name="awaiting_cash" string="Awaiting Cash"
                        domain="[('state', '=', 'awaiting_cash')]"/>
                <filter name="settled" string="Settled"
                        domain="[('state', 'in', ['carried', 'cash_settled'])]"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="restaurant_payroll_correction_hr_action" model="ir.actions.act_window">
        <field name="name">Payroll Corrections</field>
        <field name="res_model">restaurant.payroll.correction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="restaurant_payroll_correction_view_search"/>
    </record>

    <record id="restaurant_payroll_correction_accountant_action" model="ir.actions.act_window">
        <field name="name">Payroll Corrections</field>
        <field name="res_model">restaurant.payroll.correction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'search_default_awaiting_cash': 1}</field>
        <field name="search_view_id" ref="restaurant_payroll_correction_view_search"/>
    </record>
</odoo>
