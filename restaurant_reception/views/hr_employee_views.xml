<odoo>
    <record id="hr_employee_view_form_restaurant_branch" model="ir.ui.view">
        <field name="name">hr.employee.form.restaurant.branch</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_document_upload_wizard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-upload"
                        groups="restaurant_core.group_restaurant_hr,base.group_system">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Upload Documents</span>
                    </div>
                </button>
                <button name="action_open_restaurant_documents"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-id-card-o"
                        groups="restaurant_core.group_restaurant_hr,base.group_system">
                    <field name="restaurant_document_count" widget="statinfo"
                           string="Documents"/>
                </button>
                <button name="action_open_restaurant_onboarding"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tasks"
                        groups="restaurant_core.group_restaurant_hr,base.group_system">
                    <field name="restaurant_onboarding_count" widget="statinfo"
                           string="Onboarding"/>
                </button>
                <button name="action_open_restaurant_probation"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-line-chart"
                        groups="restaurant_core.group_restaurant_hr,base.group_system">
                    <field name="restaurant_probation_count" widget="statinfo"
                           string="Probation"/>
                </button>
                <button name="action_open_restaurant_disciplinary_cases"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-gavel"
                        groups="restaurant_core.group_restaurant_hr,base.group_system">
                    <field name="restaurant_disciplinary_case_count" widget="statinfo"
                           string="Disciplinary Cases"/>
                </button>
            </div>
            <field name="work_location_id" position="after">
                <field name="restaurant_employee_number"
                       string="Employee Number"
                       readonly="1"
                       groups="hr.group_hr_user,base.group_system"/>
                <field name="restaurant_branch_id"
                       string="Restaurant Branch"
                       options="{'no_create': True}"
                       groups="hr.group_hr_user,base.group_system"/>
                <field name="restaurant_staff_category_id"
                       string="Staff Category"
                       placeholder="Cleaning &amp; Stewarding, FOH &amp; BOH, Main Kitchen..."
                       groups="hr.group_hr_user,base.group_system"/>
                <field name="restaurant_immigration_status"
                       string="Visa / Sponsorship Status"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_current_sponsor_name"
                       string="Current Sponsor"
                       invisible="restaurant_immigration_status != 'other_sponsor'"
                       required="restaurant_immigration_status == 'other_sponsor'"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_work_authorized"
                       string="Employment Documents Verified"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_work_authorized_by_id"
                       string="Employment Verification Confirmed By"
                       invisible="not restaurant_work_authorized"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_work_authorized_on"
                       string="Employment Verification Confirmed On"
                       invisible="not restaurant_work_authorized"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_document_compliance_state"
                       string="Employee File Status"
                       widget="badge"
                       decoration-success="restaurant_document_compliance_state == 'complete'"
                       decoration-info="restaurant_document_compliance_state == 'in_progress'"
                       decoration-warning="restaurant_document_compliance_state == 'missing'"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_missing_document_count"
                       string="Missing Required Documents"
                       readonly="1"
                       invisible="restaurant_document_compliance_state == 'complete'"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
                <field name="restaurant_missing_document_type_ids"
                       string="Missing Requirements"
                       widget="many2many_tags"
                       readonly="1"
                       invisible="restaurant_document_compliance_state == 'complete'"
                       groups="restaurant_core.group_restaurant_hr,base.group_system"/>
            </field>
        </field>
    </record>

    <record id="hr_employee_view_list_restaurant_staff" model="ir.ui.view">
        <field name="name">hr.employee.list.restaurant.staff</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="job_title" position="after">
                <field name="restaurant_employee_number" string="Employee Number"
                       optional="show" groups="hr.group_hr_user,base.group_system"/>
                <field name="restaurant_staff_category_id" string="Staff Category"
                       optional="show" groups="hr.group_hr_user,base.group_system"/>
                <field name="restaurant_branch_id" string="Restaurant Branch"
                       optional="show" groups="hr.group_hr_user,base.group_system"/>
            </field>
        </field>
    </record>

    <record id="hr_employee_compliance_view_list" model="ir.ui.view">
        <field name="name">hr.employee.compliance.view.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Employee Compliance"
                  decoration-danger="restaurant_expired_document_count &gt; 0"
                  decoration-warning="restaurant_missing_document_count &gt; 0 or restaurant_expiring_document_count &gt; 0 or not restaurant_work_authorized"
                  decoration-success="restaurant_document_compliance_state == 'complete' and restaurant_work_authorized and not restaurant_expired_document_count and not restaurant_expiring_document_count">
                <field name="restaurant_employee_number" string="Employee Number"/>
                <field name="name" string="Employee"/>
                <field name="job_id" string="Position" optional="show"/>
                <field name="restaurant_branch_id" string="Branch"/>
                <field name="restaurant_immigration_status" string="Visa / Sponsorship Status" widget="badge"/>
                <field name="restaurant_work_authorized" string="Employment Verified" widget="boolean"/>
                <field name="restaurant_document_compliance_state" string="File Status" widget="badge"/>
                <field name="restaurant_missing_document_count" string="Missing"/>
                <field name="restaurant_expiring_document_count" string="Expiring"/>
                <field name="restaurant_expired_document_count" string="Expired"/>
                <field name="restaurant_next_document_expiry" string="Next Expiry" optional="show"/>
                <field name="restaurant_onboarding_state" string="Onboarding" widget="badge"/>
                <field name="restaurant_probation_state" string="Probation" widget="badge"/>
                <field name="restaurant_probation_end_date" string="Probation End" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_compliance_view_search" model="ir.ui.view">
        <field name="name">hr.employee.compliance.view.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Employee Compliance">
                <field name="name"/>
                <field name="restaurant_employee_number"/>
                <field name="restaurant_branch_id"/>
                <field name="restaurant_immigration_status"/>
                <separator/>
                <filter name="pre_employment" string="Pre-Employment"
                        domain="[('restaurant_immigration_status', '=', 'new_joiner')]"/>
                <filter name="transfer_pending" string="Transfer Pending"
                        domain="[('restaurant_immigration_status', '=', 'transfer_pending')]"/>
                <filter name="visa_in_process" string="Visa In Process"
                        domain="[('restaurant_immigration_status', '=', 'visa_in_process')]"/>
                <filter name="not_verified" string="Not Verified"
                        domain="[('restaurant_work_authorized', '=', False)]"/>
                <filter name="verified" string="Verified"
                        domain="[('restaurant_work_authorized', '=', True)]"/>
                <separator/>
                <filter name="missing_documents" string="Missing Documents"
                        domain="[('restaurant_document_compliance_state', '!=', 'complete')]"/>
                <filter name="expiring_documents" string="Expiring Documents"
                        domain="[('restaurant_expiring_document_count', '&gt;', 0)]"/>
                <filter name="expired_documents" string="Expired Documents"
                        domain="[('restaurant_expired_document_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="onboarding_not_started" string="Onboarding Not Started"
                        domain="[('restaurant_onboarding_state', '=', 'not_started')]"/>
                <filter name="onboarding_active" string="Onboarding Active"
                        domain="[('restaurant_onboarding_state', 'in', ['in_progress', 'extended'])]"/>
                <filter name="onboarding_failed" string="Onboarding Failed"
                        domain="[('restaurant_onboarding_state', '=', 'failed')]"/>
                <separator/>
                <filter name="probation_active" string="Probation Active"
                        domain="[('restaurant_probation_state', 'in', ['active', 'extended'])]"/>
                <filter name="probation_hr_review" string="Probation Awaiting HR"
                        domain="[('restaurant_probation_state', '=', 'hr_review')]"/>
                <group>
                    <filter name="group_branch" string="Branch"
                            context="{'group_by': 'restaurant_branch_id'}"/>
                    <filter name="group_visa_status" string="Visa Status"
                            context="{'group_by': 'restaurant_immigration_status'}"/>
                    <filter name="group_verified" string="Employment Verified"
                            context="{'group_by': 'restaurant_work_authorized'}"/>
                    <filter name="group_onboarding" string="Onboarding Status"
                            context="{'group_by': 'restaurant_onboarding_state'}"/>
                    <filter name="group_probation" string="Probation Status"
                            context="{'group_by': 'restaurant_probation_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_employee_compliance_action" model="ir.actions.act_window">
        <field name="name">Employee Compliance</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hr_employee_compliance_view_list"/>
        <field name="search_view_id" ref="hr_employee_compliance_view_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Employee compliance is ready</p>
            <p>Track visa status, verification, missing requirements and document expiry in one place.</p>
        </field>
    </record>
</odoo>
