<odoo>
    <record id="employee_document_upload_wizard_view_form" model="ir.ui.view">
        <field name="name">restaurant.employee.document.upload.wizard.form</field>
        <field name="model">restaurant.employee.document.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Employee Documents">
                <group>
                    <field name="employee_id"/>
                </group>
                <p class="text-muted">
                    Upload any available files below, then save them all once. Empty optional rows are ignored.
                </p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0"
                          decoration-warning="required_for_employee and not document_file"
                          decoration-success="document_file">
                        <field name="sequence" column_invisible="1"/>
                        <field name="document_type_id"/>
                        <field name="required_for_employee" readonly="1"/>
                        <field name="document_number"/>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                        <field name="responsible_user_id" optional="hide"/>
                        <field name="document_file" filename="document_filename"/>
                        <field name="document_filename" column_invisible="1"/>
                        <field name="notes" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_save_documents" type="object"
                            string="Save Documents" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
