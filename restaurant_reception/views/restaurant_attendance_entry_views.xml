<odoo>
    <record id="restaurant_attendance_entry_view_list" model="ir.ui.view">
        <field name="name">restaurant.attendance.entry.view.list</field>
        <field name="model">restaurant.attendance.entry</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="attendance_date"/><field name="employee_id"/><field name="branch_id"/>
                <field name="status" widget="badge"/><field name="check_in"/><field name="check_out"/>
                <field name="overtime_hours" widget="float_time" sum="Overtime"/>
                <field name="entered_by" optional="hide"/><field name="manager_reviewed_by" optional="hide"/>
                <field name="hr_reviewed_by" optional="hide"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="restaurant_attendance_entry_view_form" model="ir.ui.view">
        <field name="name">restaurant.attendance.entry.view.form</field>
        <field name="model">restaurant.attendance.entry</field>
        <field name="arch" type="xml">
            <form string="Attendance &amp; Overtime">
                <header>
                    <button name="action_submit" type="object" string="Send to Manager" class="btn-primary"
                            invisible="state != 'draft'" groups="restaurant_core.group_restaurant_reception"/>
                    <button name="action_submit_to_hr" type="object" string="Submit to HR" class="btn-primary"
                            invisible="state != 'manager_review' or not can_review_manager"/>
                    <button name="action_return_to_draft" type="object" string="Return to Reception"
                            invisible="state != 'manager_review' or not can_review_manager"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted_to_hr' or not can_review_hr"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted_to_hr' or not can_review_hr"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,manager_review,submitted_to_hr,approved"/>
                </header>
                <sheet>
                    <field name="can_review_manager" invisible="1"/><field name="can_review_hr" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">Operational attendance staging. HR approval does not create a final attendance or payroll record.</div>
                    <group>
                        <group string="Employee and Branch">
                            <field name="branch_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="employee_id" readonly="state != 'draft'" domain="[('company_id', '=', company_id)]" options="{'no_create': True, 'no_open': True}"/>
                            <field name="attendance_date" readonly="state != 'draft'"/>
                            <field name="status" readonly="state != 'draft'"/>
                        </group>
                        <group string="Time and Overtime">
                            <field name="check_in" readonly="state != 'draft'"/>
                            <field name="check_out" readonly="state != 'draft'"/>
                            <field name="overtime_hours" widget="float_time" readonly="state != 'draft'"/>
                            <field name="entered_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="review_notes" string="Review Notes">
                            <group string="Reception"><field name="reception_note" readonly="state != 'draft'" nolabel="1" placeholder="Arrival, absence or overtime observations..."/></group>
                            <group string="Branch Manager"><field name="manager_note" readonly="state != 'manager_review' or not can_review_manager" nolabel="1" placeholder="Manager review and handover to HR..."/></group>
                            <group string="HR"><field name="hr_note" readonly="state != 'submitted_to_hr' or not can_review_hr" nolabel="1" placeholder="HR decision and comments..."/></group>
                        </page>
                        <page name="audit" string="Review History">
                            <group>
                                <group string="Manager Review"><field name="manager_reviewed_by"/><field name="manager_reviewed_at"/></group>
                                <group string="HR Review"><field name="hr_reviewed_by"/><field name="hr_reviewed_at"/></group>
                                <group string="Record Audit"><field name="create_uid"/><field name="create_date"/><field name="write_uid"/><field name="write_date"/></group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="restaurant_attendance_entry_view_search" model="ir.ui.view">
        <field name="name">restaurant.attendance.entry.view.search</field>
        <field name="model">restaurant.attendance.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/><field name="branch_id"/><field name="attendance_date"/><field name="status"/><field name="state"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="manager_review" string="Manager Review" domain="[('state', '=', 'manager_review')]"/>
                <filter name="submitted_to_hr" string="Awaiting HR" domain="[('state', '=', 'submitted_to_hr')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="overtime" string="With Overtime" domain="[('overtime_hours', '&gt;', 0)]"/>
                <filter name="date" string="Attendance Date" date="attendance_date"/>
                <group>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'attendance_date:day'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="restaurant_attendance_entry_action" model="ir.actions.act_window">
        <field name="name">Attendance &amp; Overtime</field>
        <field name="res_model">restaurant.attendance.entry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record daily attendance</p><p>Reception records the facts, the branch manager reviews them, and HR makes the final decision.</p></field>
    </record>
</odoo>
